      "source_span": {
        "end": 2801,
        "start": 2634
      },
      "source_text": "Serious or active medical or psychiatric condition which, in the opinion of the investigator, may interfere with treatment, assessment, or compliance with the protocol"
    },
    {
      "criterion_id": "nct02932007-inclusion-3449060b23561f00",
      "criterion_type": "inclusion",
      "eligibility_sha256": "b4cf469ca0bd086b9706ec8a1c7ae8e26adb25ddeecefd97b19b586beeba6e10",
