      "source_id": "clinicaltrials.gov:NCT02932007:eligibility:2019-08-19:b4cf469ca0bd",
      "source_record_version": "2019-08-19:b4cf469ca0bd",
      "source_span": {
        "end": 943,
        "start": 744
      },
      "source_text": "Implanted dual chamber pacemaker/ICD capable of monitoring atrial arrhythmias or willingness to wear a 2 weeks event monitor if patient does not have a device capable of monitoring atrial arrhythmias"
    },
