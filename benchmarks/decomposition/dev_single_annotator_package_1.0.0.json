      "nct_id": "NCT07430956",
      "protocol_sha256": "8d670b662c5a6cd930635baeb26801525fae838117e15c00d79439616cd20212",
      "resolution_flags": [
        "incomplete_source_condition"
      ],
      "source_id": "clinicaltrials.gov:NCT07430956:eligibility:2026-06-23:90895ed10356",
      "source_record_version": "2026-06-23:90895ed10356",
      "source_span": {
        "end": 410,
        "start": 185
      },
      "source_text": "CHA2DS2-VA \\[C: Congestive heart failure; H: Hypertension; A2: Age ≥75 years (double points); D: Diabetes mellitus; S2: Stroke or TIA or Systemic embolism (double points); V: Vascular disease; A: Age 65-74 years\\] score ≥4 OR"
    },
    {
      "criterion_id": "nct07430956-inclusion-f63daeda8270071a",
      "criterion_type": "inclusion",
      "eligibility_sha256": "90895ed103568c221f941bfaa64805cc9938597c9cd996055d456beb50a94260",
      "expression": null,
      "nct_id": "NCT07430956",
      "protocol_sha256": "8d670b662c5a6cd930635baeb26801525fae838117e15c00d79439616cd20212",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07430956:eligibility:2026-06-23:90895ed10356",
      "source_record_version": "2026-06-23:90895ed10356",
      "source_span": {
        "end": 739,
        "start": 506
      },
      "source_text": "Shared decision making between the participant and provider determining that the bleeding risk of Oral Anticoagulant (OAC) therapy outweighs the benefits, making the participant unsuitable for OAC therapy as described in the protocol"
    },
    {
      "criterion_id": "nct07455539-exclusion-23639d187688b443",
      "criterion_type": "exclusion",
      "eligibility_sha256": "377edee9637c58d181007ac0e2fbe5c9324270d161b1f39e0fb05fa98a3017ff",
      "expression": null,
      "nct_id": "NCT07455539",
      "protocol_sha256": "beae7559c81c5c6ec8a8a1932a259411cc3262acb0434c19671d24a53a454e48",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07455539:eligibility:2026-03-06:377edee9637c",
      "source_record_version": "2026-03-06:377edee9637c",
      "source_span": {
        "end": 2605,
        "start": 2502
      },
      "source_text": "Recent (within 90 days prior to procedure) stroke, transient ischemic attack, or myocardial infarction;"
    },
    {
      "criterion_id": "nct07455539-exclusion-8fc9bee5152609cd",
      "criterion_type": "exclusion",
      "eligibility_sha256": "377edee9637c58d181007ac0e2fbe5c9324270d161b1f39e0fb05fa98a3017ff",
      "expression": null,
      "nct_id": "NCT07455539",
      "protocol_sha256": "beae7559c81c5c6ec8a8a1932a259411cc3262acb0434c19671d24a53a454e48",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07455539:eligibility:2026-03-06:377edee9637c",
      "source_record_version": "2026-03-06:377edee9637c",
      "source_span": {
        "end": 3287,
        "start": 3190
      },
      "source_text": "Left atrial appendage anatomy cannot accommodate the LAmbre II LAA Occluder per manufacturer IFU;"
    },
    {
      "criterion_id": "nct07455539-inclusion-83002ea75db4e52b",
      "criterion_type": "inclusion",
      "eligibility_sha256": "377edee9637c58d181007ac0e2fbe5c9324270d161b1f39e0fb05fa98a3017ff",
      "expression": null,
      "nct_id": "NCT07455539",
      "protocol_sha256": "beae7559c81c5c6ec8a8a1932a259411cc3262acb0434c19671d24a53a454e48",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07455539:eligibility:2026-03-06:377edee9637c",
      "source_record_version": "2026-03-06:377edee9637c",
      "source_span": {
        "end": 651,
        "start": 415
      },
      "source_text": "The patient is deemed suitable for LAA closure by the site investigator and a clinician not a part of the procedural team in the shared decision-making process, and this determination has been documented in the patient's medical record;"
    },
    {
      "criterion_id": "nct07563257-exclusion-dd19e0140f02db24",
      "criterion_type": "exclusion",
      "eligibility_sha256": "6ed0e0c03bc257bf38e6d7d7e2d0b4d6abab68fa15384ae1fbabea5606d0d0a7",
      "expression": null,
      "nct_id": "NCT07563257",
      "protocol_sha256": "96859f134e4c21fc2a635f5197d1d7e1630a308dcc3003b818029696ea38715e",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07563257:eligibility:2026-06-03:6ed0e0c03bc2",
      "source_record_version": "2026-06-03:6ed0e0c03bc2",
      "source_span": {
        "end": 570,
        "start": 486
      },
      "source_text": "• Presence of intracardiac thrombus or contraindication to systemic anticoagulation."
    },
    {
      "criterion_id": "nct07563257-inclusion-84eeadc753b5318e",
      "criterion_type": "inclusion",
      "eligibility_sha256": "6ed0e0c03bc257bf38e6d7d7e2d0b4d6abab68fa15384ae1fbabea5606d0d0a7",
      "expression": null,
      "nct_id": "NCT07563257",
      "protocol_sha256": "96859f134e4c21fc2a635f5197d1d7e1630a308dcc3003b818029696ea38715e",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07563257:eligibility:2026-06-03:6ed0e0c03bc2",
      "source_record_version": "2026-06-03:6ed0e0c03bc2",
      "source_span": {
        "end": 364,
        "start": 318
      },
      "source_text": "• Ability to provide written informed consent."
    },
    {
      "criterion_id": "nct07563257-inclusion-ca0bcbd47a554ba4",
      "criterion_type": "inclusion",
      "eligibility_sha256": "6ed0e0c03bc257bf38e6d7d7e2d0b4d6abab68fa15384ae1fbabea5606d0d0a7",
      "expression": null,
      "nct_id": "NCT07563257",
      "protocol_sha256": "96859f134e4c21fc2a635f5197d1d7e1630a308dcc3003b818029696ea38715e",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07563257:eligibility:2026-06-03:6ed0e0c03bc2",
      "source_record_version": "2026-06-03:6ed0e0c03bc2",
      "source_span": {
        "end": 108,
        "start": 42
      },
      "source_text": "• Documented persistent atrial fibrillation and/or atrial flutter."
    },
    {
      "criterion_id": "nct07687862-exclusion-eebb7fbcbb208585",
      "criterion_type": "exclusion",
      "eligibility_sha256": "716699e7490c69e0916d7f2368f6daa2f0660773dae8d9c1b228dd77dc1addd5",
      "expression": null,
      "nct_id": "NCT07687862",
      "protocol_sha256": "b77d0872c273e61b11778946c5b6af6dd28b344e147265b96c1597000648773c",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07687862:eligibility:2026-07-09:716699e7490c",
      "source_record_version": "2026-07-09:716699e7490c",
      "source_span": {
        "end": 612,
        "start": 569
      },
      "source_text": "Severe anemia or untreated thyroid disease;"
    },
    {
      "criterion_id": "nct07687862-inclusion-c7a39fa346214846",
      "criterion_type": "inclusion",
      "eligibility_sha256": "716699e7490c69e0916d7f2368f6daa2f0660773dae8d9c1b228dd77dc1addd5",
      "expression": null,
      "nct_id": "NCT07687862",
      "protocol_sha256": "b77d0872c273e61b11778946c5b6af6dd28b344e147265b96c1597000648773c",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07687862:eligibility:2026-07-09:716699e7490c",
      "source_record_version": "2026-07-09:716699e7490c",
      "source_span": {
        "end": 39,
        "start": 24
      },
      "source_text": "Age ≥ 18 years;"
    },
    {
      "criterion_id": "nct07715929-exclusion-6fcd645b1ca00b43",
      "criterion_type": "exclusion",
      "eligibility_sha256": "a13918011fce5af54e4e52d6a947554c52ccd8c002f5a8eca9b87c88f65b9362",
      "expression": null,
      "nct_id": "NCT07715929",
      "protocol_sha256": "2d753c3a08a74dacc1fd33707fdb65a52a0401595d3d0920bb6b955eb9379b39",
      "resolution_flags": [
        "source_span_contamination"
      ],
      "source_id": "clinicaltrials.gov:NCT07715929:eligibility:2026-07-21:a13918011fce",
      "source_record_version": "2026-07-21:a13918011fce",
      "source_span": {
        "end": 2134,
        "start": 1947
      },
      "source_text": "Acute coronary syndrome (ACS), ischemic stroke/TIA, or major cardiac surgery within 6 months prior to screening\n\nTirzepatide-Specific Exclusion Criteria (per NMPA Prescribing Information)"
    },
    {
      "criterion_id": "nct07715929-inclusion-0eaa5a137c984e76",
      "criterion_type": "inclusion",
      "eligibility_sha256": "a13918011fce5af54e4e52d6a947554c52ccd8c002f5a8eca9b87c88f65b9362",
      "expression": null,
      "nct_id": "NCT07715929",
      "protocol_sha256": "2d753c3a08a74dacc1fd33707fdb65a52a0401595d3d0920bb6b955eb9379b39",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07715929:eligibility:2026-07-21:a13918011fce",
      "source_record_version": "2026-07-21:a13918011fce",
      "source_span": {
        "end": 1071,
        "start": 895
      },
      "source_text": "Undergoing catheter ablation for AF at a participating center, with confirmed successful restoration of sinus rhythm at the end of the procedure (as determined by the operator)"
    },
    {
      "criterion_id": "nct07715929-inclusion-544aaaaf9d6f82b8",
      "criterion_type": "inclusion",
      "eligibility_sha256": "a13918011fce5af54e4e52d6a947554c52ccd8c002f5a8eca9b87c88f65b9362",
      "expression": null,
      "nct_id": "NCT07715929",
      "protocol_sha256": "2d753c3a08a74dacc1fd33707fdb65a52a0401595d3d0920bb6b955eb9379b39",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07715929:eligibility:2026-07-21:a13918011fce",
      "source_record_version": "2026-07-21:a13918011fce",
      "source_span": {
        "end": 1238,
        "start": 1074
      },
      "source_text": "Willing and able to understand the study procedures, provide written informed consent, and comply with all protocol requirements including 12-month follow-up visits"
    },
    {
      "criterion_id": "nct07715929-inclusion-c62ef21c5c87b412",
      "criterion_type": "inclusion",
      "eligibility_sha256": "a13918011fce5af54e4e52d6a947554c52ccd8c002f5a8eca9b87c88f65b9362",
      "expression": null,
      "nct_id": "NCT07715929",
      "protocol_sha256": "2d753c3a08a74dacc1fd33707fdb65a52a0401595d3d0920bb6b955eb9379b39",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07715929:eligibility:2026-07-21:a13918011fce",
      "source_record_version": "2026-07-21:a13918011fce",
      "source_span": {
        "end": 751,
        "start": 313
      },
      "source_text": "Body weight criteria (aligned with NMPA-approved tirzepatide indication) meeting at least one of the following:\n\nBMI ≥28.0 kg/m² (obesity threshold per Chinese criteria), OR BMI ≥24.0 kg/m² and \\<28.0 kg/m² (overweight per Chinese criteria) with at least one weight-related comorbidity: hypertension, dyslipidemia, type 2 diabetes mellitus (T2DM), obstructive sleep apnea syndrome (OSAS), or atherosclerotic cardiovascular disease (ASCVD)"
    },
    {
      "criterion_id": "nct07715929-inclusion-c6ddf661e250f976",
      "criterion_type": "inclusion",
      "eligibility_sha256": "a13918011fce5af54e4e52d6a947554c52ccd8c002f5a8eca9b87c88f65b9362",
      "expression": null,
      "nct_id": "NCT07715929",
      "protocol_sha256": "2d753c3a08a74dacc1fd33707fdb65a52a0401595d3d0920bb6b955eb9379b39",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT07715929:eligibility:2026-07-21:a13918011fce",
      "source_record_version": "2026-07-21:a13918011fce",
      "source_span": {
        "end": 75,
        "start": 23
      },
      "source_text": "Age ≥18 years and ≤75 years at the time of screening"
    }
  ],
