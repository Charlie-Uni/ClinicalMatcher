      "source_id": "clinicaltrials.gov:NCT02932007:eligibility:2019-08-19:b4cf469ca0bd",
      "source_record_version": "2019-08-19:b4cf469ca0bd",
      "source_span": {
        "end": 580,
        "start": 376
      },
      "source_text": "AF must be documented at least once either by ECG, event monitoring, loop recorder, telemetry, trans-telephonic monitoring, pacemaker or cardiac defibrillator readouts within 24 months prior to enrollment"
    },
    {
      "criterion_id": "nct02932007-inclusion-9fa662d9d6bd53f7",
      "criterion_type": "inclusion",
      "eligibility_sha256": "b4cf469ca0bd086b9706ec8a1c7ae8e26adb25ddeecefd97b19b586beeba6e10",
      "expression": null,
      "nct_id": "NCT02932007",
      "protocol_sha256": "9ab7e5ab649589927545e06dbc10b6dde12a75499ca2224696dd505643752ca5",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT02932007:eligibility:2019-08-19:b4cf469ca0bd",
      "source_record_version": "2019-08-19:b4cf469ca0bd",
      "source_span": {
        "end": 372,
        "start": 50
      },
      "source_text": "History of symptomatic persistent AF Persistent AF - defined as continuous AF that is sustained more than 7 days but less than 12 months. Episodes of AF of ≥ 48 hours duration in which a decision is made to terminate with electrical or pharmacological cardioversion prior to 7 days will also be classified as persistent AF"
    },
    {
      "criterion_id": "nct02932007-inclusion-a87b29150a5fc629",
      "criterion_type": "inclusion",
      "eligibility_sha256": "b4cf469ca0bd086b9706ec8a1c7ae8e26adb25ddeecefd97b19b586beeba6e10",
      "expression": null,
      "nct_id": "NCT02932007",
      "protocol_sha256": "9ab7e5ab649589927545e06dbc10b6dde12a75499ca2224696dd505643752ca5",
      "resolution_flags": [],
      "source_id": "clinicaltrials.gov:NCT02932007:eligibility:2019-08-19:b4cf469ca0bd",
      "source_record_version": "2019-08-19:b4cf469ca0bd",
      "source_span": {
        "end": 740,
        "start": 584
      },
      "source_text": "Currently on anticoagulation therapy as indicated per local guidelines, which is considered optimal for stroke prevention in the opinion of the investigator"
    },
    {
      "criterion_id": "nct02932007-inclusion-ce4fe9d7f97194cb",
      "criterion_type": "inclusion",
      "eligibility_sha256": "b4cf469ca0bd086b9706ec8a1c7ae8e26adb25ddeecefd97b19b586beeba6e10",
      "expression": null,
