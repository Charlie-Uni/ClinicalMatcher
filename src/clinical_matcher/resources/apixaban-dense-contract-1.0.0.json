    "commercial_use_restriction": false
  },
  "models": {
    "query_encoder": {
      "model_id": "ncbi/MedCPT-Query-Encoder",
      "revision": "d83a36cc6b8e3a5c5e9d9d6ba156808c1643dcbc"
    },
    "document_encoder": {
      "model_id": "ncbi/MedCPT-Article-Encoder",
