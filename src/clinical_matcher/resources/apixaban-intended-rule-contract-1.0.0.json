    {
      "rule_id": "apixaban-rule-1",
      "description": "Non-valvular AFib with the scored ablation/valvular branch and no scored bleeding risk",
      "source_formula": "AFib == true AND (ablation == false OR valvular_surgery == false) AND hemorrhagic == false AND peptic_ulcer == false AND recent_serious_bleeding == false",
      "hard": true,
      "expression": {
        "operator": "all",
        "children": [
          {
            "atom": {
              "condition_id": "r1-afib-present",
              "source_criterion_label": "afib",
              "fact_field": "atrial_fibrillation",
              "operator": "==",
              "expected": {"value_type": "boolean", "value": true, "unit": null}
            }
          },
          {
            "operator": "any",
            "children": [
              {
                "atom": {
                  "condition_id": "r1-ablation-absent",
                  "source_criterion_label": "afib_ablation",
                  "fact_field": "afib_ablation",
                  "operator": "==",
                  "expected": {"value_type": "boolean", "value": false, "unit": null}
                }
              },
              {
                "atom": {
                  "condition_id": "r1-valvular-absent",
                  "source_criterion_label": "surgical_valvular_disease",
                  "fact_field": "valvular_disease_requiring_surgery",
                  "operator": "==",
                  "expected": {"value_type": "boolean", "value": false, "unit": null}
                }
              }
            ]
          },
          {
            "atom": {
              "condition_id": "r1-hemorrhagic-absent",
              "source_criterion_label": "hemorrhagic",
              "fact_field": "hemorrhagic_tendency_or_blood_dyscrasia",
              "operator": "==",
              "expected": {"value_type": "boolean", "value": false, "unit": null}
            }
          },
          {
            "atom": {
              "condition_id": "r1-ulcer-absent",
              "source_criterion_label": "peptic_ulcer_disease",
              "fact_field": "peptic_ulcer_disease",
              "operator": "==",
              "expected": {"value_type": "boolean", "value": false, "unit": null}
            }
          },
          {
            "atom": {
              "condition_id": "r1-bleeding-absent",
              "source_criterion_label": "bleeding",
              "fact_field": "serious_bleeding_within_6_months",
              "operator": "==",
              "expected": {"value_type": "boolean", "value": false, "unit": null}
            }
          }
        ]
      }
    },
