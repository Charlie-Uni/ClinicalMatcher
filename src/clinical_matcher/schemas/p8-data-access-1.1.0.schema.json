{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/p8-data-access-1.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "self_sha256",
    "hash_semantics",
    "p8_access_version",
    "synthetic",
    "catalog_pin",
    "source_split_pin",
    "reservation_pin",
    "populations",
    "independence_review",
    "artifacts",
    "holdout_authorized",
    "locked_test_permanently_closed",
    "holdout_lifetime_exposures",
    "replacement_holdout_forbidden",
    "source_metadata",
    "mechanical_export_record",
    "mechanical_export_pin"
  ],
  "properties": {
    "self_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash_semantics": {
      "const": {
        "storage": "sha256_canonical_json_without_top_level_self_sha256",
        "consumption": "remove_self_sha256_then_recompute_canonical_json",
        "canonicalization": "utf8_ensure_ascii_false_sort_keys_true_compact_no_nan"
      }
    },
    "p8_access_version": {
      "const": "1.1.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "catalog_pin": {
      "allOf": [
        {
          "$ref": "#/$defs/hashPin"
        },
        {
          "properties": {
            "kind": {
              "const": "self"
            },
            "self_field": {
              "const": "catalog_sha256"
            }
          }
        }
      ]
    },
    "source_split_pin": {
      "allOf": [
        {
          "$ref": "#/$defs/hashPin"
        },
        {
          "properties": {
            "kind": {
              "const": "self"
            },
            "self_field": {
              "const": "manifest_sha256"
            }
          }
        }
      ]
    },
    "reservation_pin": {
      "allOf": [
        {
          "$ref": "#/$defs/hashPin"
        },
        {
          "properties": {
            "kind": {
              "const": "self"
            },
            "self_field": {
              "const": "manifest_sha256"
            }
          }
        }
      ]
    },
    "populations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_fit",
        "validation",
        "secondary_holdout"
      ],
      "properties": {
        "train_fit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^patient-[0-9a-f]{24}$"
          }
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^patient-[0-9a-f]{24}$"
          }
        },
        "secondary_holdout": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^patient-[0-9a-f]{24}$"
          }
        }
      }
    },
    "independence_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "review_record_id",
        "uses_checked",
        "evidence_pins",
        "unresolved_items",
        "development_use_found",
        "claim_scope",
        "owner_attestation"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "review_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "uses_checked": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "development_inspection",
              "fitting",
              "selection",
              "examples",
              "subsequent_annotation",
              "calibration",
              "evaluation"
            ]
          }
        },
        "evidence_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hashPin"
          }
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "development_use_found": {
          "type": "boolean"
        },
        "claim_scope": {
          "const": "audited_inventory_and_owner_attestation"
        },
        "owner_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "no_unrecorded_manual_inspection",
            "no_real_sft_export",
            "no_real_silver_generation"
          ],
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "no_unrecorded_manual_inspection": {
              "const": true
            },
            "no_real_sft_export": {
              "const": true
            },
            "no_real_silver_generation": {
              "const": true
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "partition",
          "kind",
          "scope",
          "path",
          "file_pin",
          "content_pin"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "partition": {
            "enum": [
              "train_fit",
              "validation",
              "secondary_holdout"
            ]
          },
          "kind": {
            "enum": [
              "evidence",
              "gold",
              "raw_predictions",
              "examples"
            ]
          },
          "scope": {
            "const": "preisolated_partition_only"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "file_pin": {
            "allOf": [
              {
                "$ref": "#/$defs/hashPin"
              },
              {
                "properties": {
                  "kind": {
                    "const": "file"
                  }
                }
              }
            ]
          },
          "content_pin": {
            "allOf": [
              {
                "$ref": "#/$defs/hashPin"
              },
              {
                "properties": {
                  "kind": {
                    "const": "content"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "holdout_authorized": {
      "const": false
    },
    "locked_test_permanently_closed": {
      "const": true
    },
    "holdout_lifetime_exposures": {
      "const": 1
    },
    "replacement_holdout_forbidden": {
      "const": true
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split",
        "reservation"
      ],
      "properties": {
        "split": {
          "type": "object"
        },
        "reservation": {
          "type": "object"
        }
      }
    },
    "mechanical_export_record": {
      "type": "object"
    },
    "mechanical_export_pin": {
      "$ref": "#/$defs/hashPin"
    }
  },
  "$defs": {
    "hashPin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "null"
            },
            "storage": {
              "const": "sha256_exact_file_bytes"
            },
            "consumption": {
              "const": "rehash_exact_file_bytes"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "content"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "null"
            },
            "storage": {
              "const": "sha256_canonical_json"
            },
            "consumption": {
              "const": "rehash_canonical_json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "self"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "const": "sha256_canonical_json_without_named_field"
            },
            "consumption": {
              "const": "remove_named_field_then_rehash"
            }
          }
        }
      ]
    }
  }
}
