{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-error-attribution-report-1.1.0.schema.json",
  "title": "Restricted aggregate Apixaban error attribution report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "generated_at", "code_commit", "provenance", "policy", "population", "category_counts", "requested_dimensions", "representative_case_review", "limitations"],
  "properties": {
    "report_version": {"const": "1.1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_set_sha256", "benchmark_sha256", "staging_corpus_sha256", "split_manifest_sha256", "question_catalog_sha256", "split_name", "model_id", "prompt_version"],
      "properties": {
        "prediction_set_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "staging_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "question_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "split_name": {"enum": ["train", "validation", "test"]},
        "model_id": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "error_universe", "precedence", "diagnostic_not_causal_proof", "known_fact_empty_evidence_exceptions", "test_labels_used_for_design"],
      "properties": {
        "policy_version": {"const": "1.1.0"},
        "error_universe": {"const": "typed_gold_mismatch_or_known_fact_evidence_or_unit_contract_violation"},
        "precedence": {"$ref": "#/$defs/errorCategories"},
        "diagnostic_not_causal_proof": {"const": true},
        "known_fact_empty_evidence_exceptions": {
          "const": [{
            "source_criterion_label": "med_decisions",
            "fact_status": "absent",
            "value": false,
            "basis": "source_question_default_absent"
          }]
        },
        "test_labels_used_for_design": {"const": false}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patient_count", "row_count", "typed_gold_mismatch_count", "known_without_usable_evidence_count", "attributed_error_count", "no_attributed_error_count"],
      "properties": {
        "patient_count": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 1},
        "typed_gold_mismatch_count": {"type": "integer", "minimum": 0},
        "known_without_usable_evidence_count": {"type": "integer", "minimum": 0},
        "attributed_error_count": {"type": "integer", "minimum": 0},
        "no_attributed_error_count": {"type": "integer", "minimum": 0}
      }
    },
    "category_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsupported_answering", "unit_contract_error", "abstention_on_gold_known", "numeric_value_error", "fact_status_error_with_patient_local_citation", "other_typed_error"],
      "properties": {
        "unsupported_answering": {"type": "integer", "minimum": 0},
        "unit_contract_error": {"type": "integer", "minimum": 0},
        "abstention_on_gold_known": {"type": "integer", "minimum": 0},
        "numeric_value_error": {"type": "integer", "minimum": 0},
        "fact_status_error_with_patient_local_citation": {"type": "integer", "minimum": 0},
        "other_typed_error": {"type": "integer", "minimum": 0}
      }
    },
    "requested_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_failure", "reasoning_failure_with_usable_evidence", "numeric_value_error", "unit_error", "time_error", "negation_error", "false_abstention", "unsupported_answering"],
      "properties": {
        "retrieval_failure": {"$ref": "#/$defs/dimension"},
        "reasoning_failure_with_usable_evidence": {"$ref": "#/$defs/dimension"},
        "numeric_value_error": {"$ref": "#/$defs/dimension"},
        "unit_error": {"$ref": "#/$defs/dimension"},
        "time_error": {"$ref": "#/$defs/dimension"},
        "negation_error": {"$ref": "#/$defs/dimension"},
        "false_abstention": {"$ref": "#/$defs/dimension"},
        "unsupported_answering": {"$ref": "#/$defs/dimension"}
      }
    },
    "representative_case_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_error_count", "case_identifiers_emitted", "required_for_p4_5_completion"],
      "properties": {
        "status": {"enum": ["pending_authorized_environment", "completed_authorized_environment"]},
        "reviewed_error_count": {"type": "integer", "minimum": 0},
        "case_identifiers_emitted": {"const": false},
        "required_for_p4_5_completion": {"const": true}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "errorCategories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["unsupported_answering", "unit_contract_error", "abstention_on_gold_known", "numeric_value_error", "fact_status_error_with_patient_local_citation", "other_typed_error"]}
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["evaluated", "not_evaluable"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
