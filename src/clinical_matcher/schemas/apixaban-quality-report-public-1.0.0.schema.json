{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-quality-report-public-1.0.0.schema.json",
  "title": "Disclosure-controlled Apixaban quality-report candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apixaban_public_quality_report_version",
    "report_sha256",
    "report_scope",
    "generated_at",
    "source",
    "disclosure_control",
    "totals",
    "questions",
    "quality",
    "disclosure_note"
  ],
  "properties": {
    "apixaban_public_quality_report_version": {"const": "1.0.0"},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "report_scope": {"const": "aggregate_public_candidate"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "benchmark_version",
        "question_catalog_version",
        "question_catalog_sha256"
      ],
      "properties": {
        "dataset_id": {"const": "MIMIC-IV-Ext-Apixaban-Trial-Criteria-Questions"},
        "dataset_version": {"const": "1.0.0"},
        "benchmark_version": {"const": "1.0.0"},
        "question_catalog_version": {"const": "1.0.0"},
        "question_catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "disclosure_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_cell_size",
        "zero_counts_are_disclosable",
        "complementary_suppression",
        "numeric_extrema_disclosed",
        "governance_status",
        "governance_approval_reference",
        "release_authorized",
        "suppressed_cell_count"
      ],
      "properties": {
        "minimum_cell_size": {"type": "integer", "minimum": 2},
        "zero_counts_are_disclosable": {"const": true},
        "complementary_suppression": {"const": true},
        "numeric_extrema_disclosed": {"const": false},
        "governance_status": {"enum": ["pending_review", "approved"]},
        "governance_approval_reference": {"type": ["string", "null"]},
        "release_authorized": {"type": "boolean"},
        "suppressed_cell_count": {"type": "integer", "minimum": 0}
      }
    },
    "totals": {"$ref": "#/$defs/publicTotals"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/publicQuestion"}
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_patient_question_grid",
        "source_anomalies_preserved",
        "values_removed_count",
        "plausibility_rule_status"
      ],
      "properties": {
        "complete_patient_question_grid": {"type": "boolean"},
        "source_anomalies_preserved": {"const": true},
        "values_removed_count": {"const": 0},
        "plausibility_rule_status": {
          "const": "not_assessed_no_reviewed_unit_aware_rules"
        }
      }
    },
    "disclosure_note": {"$ref": "#/$defs/nonEmptyString"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "countCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "suppressed", "suppression_reason"],
      "properties": {
        "value": {"type": ["integer", "null"], "minimum": 0},
        "suppressed": {"type": "boolean"},
        "suppression_reason": {
          "type": ["string", "null"],
          "enum": [null, "minimum_cell_or_complementary_suppression"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"suppressed": {"const": true}}},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "suppression_reason": {"type": "string"}
            }
          },
          "else": {
            "properties": {
              "value": {"type": "integer"},
              "suppression_reason": {"type": "null"}
            }
          }
        }
      ]
    },
    "rateCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "suppressed", "suppression_reason"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "suppressed": {"type": "boolean"},
        "suppression_reason": {
          "type": ["string", "null"],
          "enum": [null, "derived_from_suppressed_cell"]
        }
      }
    },
    "statusCells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "absent", "unknown"],
      "properties": {
        "present": {"$ref": "#/$defs/countCell"},
        "absent": {"$ref": "#/$defs/countCell"},
        "unknown": {"$ref": "#/$defs/countCell"}
      }
    },
    "sourceCells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answered", "not_specified", "source_anomaly"],
      "properties": {
        "answered": {"$ref": "#/$defs/countCell"},
        "not_specified": {"$ref": "#/$defs/countCell"},
        "source_anomaly": {"$ref": "#/$defs/countCell"}
      }
    },
    "publicTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_count",
        "question_count",
        "assessment_count",
        "expected_assessment_count",
        "missing_patient_question_pair_count",
        "duplicate_patient_question_pair_count",
        "complete_patient_count",
        "incomplete_patient_count",
        "minimum_assessments_per_patient",
        "maximum_assessments_per_patient",
        "boolean_assessment_count",
        "numeric_assessment_count",
        "present_count",
        "absent_count",
        "unknown_count",
        "answered_source_count",
        "not_specified_source_count",
        "source_anomaly_count"
      ],
      "properties": {
        "patient_count": {"type": "integer", "minimum": 1},
        "question_count": {"type": "integer", "minimum": 1},
        "assessment_count": {"type": "integer", "minimum": 1},
        "expected_assessment_count": {"type": "integer", "minimum": 1},
        "missing_patient_question_pair_count": {"type": "integer", "minimum": 0},
        "duplicate_patient_question_pair_count": {"type": "integer", "minimum": 0},
        "complete_patient_count": {"type": "integer", "minimum": 0},
        "incomplete_patient_count": {"type": "integer", "minimum": 0},
        "minimum_assessments_per_patient": {"type": "integer", "minimum": 0},
        "maximum_assessments_per_patient": {"type": "integer", "minimum": 0},
        "boolean_assessment_count": {"type": "integer", "minimum": 0},
        "numeric_assessment_count": {"type": "integer", "minimum": 0},
        "present_count": {"$ref": "#/$defs/countCell"},
        "absent_count": {"$ref": "#/$defs/countCell"},
        "unknown_count": {"$ref": "#/$defs/countCell"},
        "answered_source_count": {"$ref": "#/$defs/countCell"},
        "not_specified_source_count": {"$ref": "#/$defs/countCell"},
        "source_anomaly_count": {"$ref": "#/$defs/countCell"}
      }
    },
    "publicNumericSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_value_count",
        "minimum",
        "maximum",
        "extrema_suppression_reason",
        "plausibility_rule_status",
        "flagged_implausible_value_count",
        "removed_value_count"
      ],
      "properties": {
        "known_value_count": {"$ref": "#/$defs/countCell"},
        "minimum": {"type": "null"},
        "maximum": {"type": "null"},
        "extrema_suppression_reason": {"const": "individual_extrema_require_separate_governance_review"},
        "plausibility_rule_status": {
          "const": "not_assessed_no_reviewed_unit_aware_rule"
        },
        "flagged_implausible_value_count": {"type": "null"},
        "removed_value_count": {"const": 0}
      }
    },
    "publicQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "source_criterion_label",
        "fact_field",
        "question_type",
        "aggregation",
        "assessment_count",
        "fact_status_counts",
        "source_status_counts",
        "unknown_rate",
        "numeric_summary"
      ],
      "properties": {
        "question_id": {"type": "string", "pattern": "^apixaban-q-[0-9a-f]{16}$"},
        "source_criterion_label": {"$ref": "#/$defs/nonEmptyString"},
        "fact_field": {"$ref": "#/$defs/nonEmptyString"},
        "question_type": {"enum": ["boolean", "numeric"]},
        "aggregation": {"enum": ["question_defined_boolean", "minimum", "maximum"]},
        "assessment_count": {"type": "integer", "minimum": 1},
        "fact_status_counts": {"$ref": "#/$defs/statusCells"},
        "source_status_counts": {"$ref": "#/$defs/sourceCells"},
        "unknown_rate": {"$ref": "#/$defs/rateCell"},
        "numeric_summary": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/publicNumericSummary"}
          ]
        }
      }
    }
  }
}
