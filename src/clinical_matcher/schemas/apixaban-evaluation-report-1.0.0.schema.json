{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-evaluation-report-1.0.0.schema.json",
  "title": "Restricted Apixaban typed-fact evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "run_id",
    "generated_at",
    "provenance",
    "tolerance_policy",
    "metrics",
    "bootstrap",
    "limitations",
    "disclosure_note"
  ],
  "properties": {
    "report_version": {"const": "1.0.0"},
    "run_id": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_sha256",
        "split_manifest_sha256",
        "split_name",
        "split_seed",
        "prediction_set_sha256",
        "model_id",
        "prompt_version",
        "prediction_code_commit",
        "code_commit"
      ],
      "properties": {
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "split_name": {"enum": ["train", "validation", "test"]},
        "split_seed": {"type": "integer", "minimum": 0},
        "prediction_set_sha256": {"$ref": "#/$defs/sha256"},
        "model_id": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "prediction_code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "tolerance_policy": {"type": "object"},
    "metrics": {"type": "object"},
    "bootstrap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/interval"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "disclosure_note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "lower", "upper", "confidence", "samples", "cluster_count"],
      "properties": {
        "estimate": {"type": "number"},
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "samples": {"type": "integer", "minimum": 1},
        "cluster_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
