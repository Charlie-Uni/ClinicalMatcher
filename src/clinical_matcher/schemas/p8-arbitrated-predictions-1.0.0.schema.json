{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "p8_arbitration_version": {
      "const": "1.0.0"
    },
    "self_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash_semantics": {
      "const": {
        "storage": "sha256_canonical_json_without_top_level_self_sha256",
        "consumption": "remove_self_sha256_then_recompute_canonical_json",
        "canonicalization": "utf8_ensure_ascii_false_sort_keys_true_compact_no_nan"
      }
    },
    "partition": {
      "const": "validation"
    },
    "view": {
      "const": "raw"
    },
    "candidate_id": {
      "enum": [
        "long_context.A1",
        "long_context.A2",
        "long_context.A3",
        "long_context.A4",
        "structured.A1",
        "structured.A2",
        "structured.A3",
        "structured.A4"
      ]
    },
    "policy_pin": {
      "$ref": "#/$defs/hashPin"
    },
    "source_pins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llm": {
          "$ref": "#/$defs/hashPin"
        },
        "rules": {
          "$ref": "#/$defs/hashPin"
        }
      },
      "required": [
        "llm",
        "rules"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prediction"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "patient_id": {
            "$ref": "#/$defs/patientId"
          },
          "question_id": {
            "$ref": "#/$defs/questionId"
          },
          "source_arm": {
            "enum": [
              "rules",
              "structured",
              "long_context"
            ]
          },
          "reason": {
            "enum": [
              "llm_abstained_rule_fallback",
              "numeric_rule_priority",
              "raw_llm_priority",
              "neither_available_keep_llm_unknown"
            ]
          },
          "source_row_pin": {
            "$ref": "#/$defs/hashPin"
          }
        },
        "required": [
          "patient_id",
          "question_id",
          "source_arm",
          "reason",
          "source_row_pin"
        ]
      }
    }
  },
  "required": [
    "p8_arbitration_version",
    "self_sha256",
    "hash_semantics",
    "partition",
    "view",
    "candidate_id",
    "policy_pin",
    "source_pins",
    "rows",
    "provenance"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patientId": {
      "type": "string",
      "pattern": "^patient-[0-9a-f]{24}$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^apixaban-q-[0-9a-f]{16}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^evidence-[0-9a-f]{24}-[0-9]{3,}$"
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_id",
        "question_id",
        "question_type",
        "fact_status",
        "value",
        "unit",
        "abstained",
        "abstention_reason",
        "evidence_ids"
      ],
      "properties": {
        "patient_id": {
          "$ref": "#/$defs/patientId"
        },
        "question_id": {
          "$ref": "#/$defs/questionId"
        },
        "question_type": {
          "enum": [
            "boolean",
            "numeric"
          ]
        },
        "fact_status": {
          "enum": [
            "present",
            "absent",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "abstained": {
          "type": "boolean"
        },
        "abstention_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        },
        "trace_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          }
        },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fact_status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "abstained": {
                "const": true
              },
              "abstention_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "abstained": {
                "const": false
              },
              "abstention_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "fact_status": {
                    "const": "present"
                  },
                  "value": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "fact_status": {
                    "const": "absent"
                  },
                  "value": {
                    "const": false
                  }
                }
              },
              {
                "properties": {
                  "fact_status": {
                    "const": "unknown"
                  },
                  "value": {
                    "type": "null"
                  }
                }
              }
            ]
          },
          "else": {
            "oneOf": [
              {
                "properties": {
                  "fact_status": {
                    "const": "present"
                  },
                  "value": {
                    "type": "number"
                  }
                }
              },
              {
                "properties": {
                  "fact_status": {
                    "const": "unknown"
                  },
                  "value": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "trace_ids"
          ]
        },
        {
          "required": [
            "rule_ids"
          ]
        }
      ]
    },
    "hashPin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "null"
            },
            "storage": {
              "const": "sha256_exact_file_bytes"
            },
            "consumption": {
              "const": "rehash_exact_file_bytes"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "content"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "null"
            },
            "storage": {
              "const": "sha256_canonical_json"
            },
            "consumption": {
              "const": "rehash_canonical_json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "self"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "const": "sha256_canonical_json_without_named_field"
            },
            "consumption": {
              "const": "remove_named_field_then_rehash"
            }
          }
        }
      ]
    }
  }
}
