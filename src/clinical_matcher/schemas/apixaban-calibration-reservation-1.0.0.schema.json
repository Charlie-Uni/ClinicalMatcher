{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-calibration-reservation-1.0.0.schema.json",
  "title": "Restricted Apixaban calibration-only patient reservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apixaban_calibration_reservation_version",
    "manifest_sha256",
    "generated_at",
    "code_commit",
    "generation_command",
    "source",
    "policy",
    "partitions",
    "isolation",
    "restrictions",
    "disclosure_note"
  ],
  "properties": {
    "apixaban_calibration_reservation_version": {"const": "1.0.0"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generation_command": {"$ref": "#/$defs/nonEmptyString"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_manifest_sha256",
        "benchmark_sha256",
        "staging_corpus_sha256",
        "source_train_patient_count"
      ],
      "properties": {
        "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "staging_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "source_train_patient_count": {"type": "integer", "minimum": 2}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "algorithm_version",
        "selection_salt",
        "selection_unit",
        "selection_input_partition",
        "calibration_patient_count",
        "selection_status"
      ],
      "properties": {
        "algorithm": {"const": "sha256_ranked_patient_reservation"},
        "algorithm_version": {"const": "1.0.0"},
        "selection_salt": {"const": "clinicalmatcher-p5-calibration-only-v1"},
        "selection_unit": {"const": "patient"},
        "selection_input_partition": {"const": "train"},
        "calibration_patient_count": {"type": "integer", "minimum": 1},
        "selection_status": {"const": "predeclared_not_searched"}
      }
    },
    "partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train_fit", "calibration_only"],
      "properties": {
        "train_fit": {"$ref": "#/$defs/partition"},
        "calibration_only": {"$ref": "#/$defs/partition"}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_train_covered_once",
        "cross_partition_patient_overlap_count",
        "validation_membership_used_for_selection",
        "test_membership_used_for_selection",
        "validation_or_test_labels_used"
      ],
      "properties": {
        "source_train_covered_once": {"const": true},
        "cross_partition_patient_overlap_count": {"const": 0},
        "validation_membership_used_for_selection": {"const": false},
        "test_membership_used_for_selection": {"const": false},
        "validation_or_test_labels_used": {"const": false}
      }
    },
    "restrictions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "disclosure_note": {"$ref": "#/$defs/nonEmptyString"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "patientId": {"type": "string", "pattern": "^patient-[0-9a-f]{24}$"},
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patient_count", "patient_ids", "patient_ids_sha256"],
      "properties": {
        "patient_count": {"type": "integer", "minimum": 1},
        "patient_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/patientId"}
        },
        "patient_ids_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
