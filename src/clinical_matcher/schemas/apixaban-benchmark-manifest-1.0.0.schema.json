{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-benchmark-manifest-1.0.0.schema.json",
  "title": "Aggregate restricted Apixaban benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apixaban_benchmark_manifest_version",
    "manifest_sha256",
    "generated_at",
    "code_commit",
    "source",
    "adapter",
    "output",
    "counts",
    "quality",
    "modifications",
    "disclosure_note"
  ],
  "properties": {
    "apixaban_benchmark_manifest_version": {"const": "1.0.0"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "source_csv_sha256",
        "staging_corpus_sha256",
        "import_manifest_sha256",
        "question_catalog_sha256"
      ],
      "properties": {
        "dataset_id": {"const": "MIMIC-IV-Ext-Apixaban-Trial-Criteria-Questions"},
        "dataset_version": {"const": "1.0.0"},
        "source_csv_sha256": {"$ref": "#/$defs/sha256"},
        "staging_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "import_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "question_catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "apixaban-staging-to-fact-benchmark"},
        "version": {"const": "1.0.0"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_sha256", "restricted_local_only"],
      "properties": {
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "restricted_local_only": {"const": true}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_count",
        "question_count",
        "assessment_count",
        "boolean_assessment_count",
        "numeric_assessment_count",
        "present_count",
        "absent_count",
        "unknown_count",
        "answered_source_count",
        "not_specified_source_count",
        "source_anomaly_count"
      ],
      "properties": {
        "patient_count": {"type": "integer", "minimum": 1},
        "question_count": {"type": "integer", "minimum": 1},
        "assessment_count": {"type": "integer", "minimum": 1},
        "boolean_assessment_count": {"type": "integer", "minimum": 0},
        "numeric_assessment_count": {"type": "integer", "minimum": 0},
        "present_count": {"type": "integer", "minimum": 0},
        "absent_count": {"type": "integer", "minimum": 0},
        "unknown_count": {"type": "integer", "minimum": 0},
        "answered_source_count": {"type": "integer", "minimum": 0},
        "not_specified_source_count": {"type": "integer", "minimum": 0},
        "source_anomaly_count": {"type": "integer", "minimum": 0}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_patient_question_grid",
        "unique_patient_question_pairs",
        "source_anomalies_preserved",
        "contains_note_text",
        "contains_raw_identifiers",
        "contains_eligibility_labels",
        "gold_evidence_available"
      ],
      "properties": {
        "complete_patient_question_grid": {"const": true},
        "unique_patient_question_pairs": {"const": true},
        "source_anomalies_preserved": {"const": true},
        "contains_note_text": {"const": false},
        "contains_raw_identifiers": {"const": false},
        "contains_eligibility_labels": {"const": false},
        "gold_evidence_available": {"const": false}
      }
    },
    "modifications": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "disclosure_note": {"$ref": "#/$defs/nonEmptyString"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1}
  }
}
