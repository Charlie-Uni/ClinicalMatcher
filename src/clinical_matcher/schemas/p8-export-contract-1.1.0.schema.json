{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "self_sha256",
    "hash_semantics",
    "p8_export_contract_version",
    "synthetic",
    "policy_pin",
    "source_split_pin",
    "reservation_pin",
    "owner_decision_record_id",
    "sources",
    "implementation"
  ],
  "properties": {
    "self_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash_semantics": {
      "const": {
        "storage": "sha256_canonical_json_without_top_level_self_sha256",
        "consumption": "remove_self_sha256_then_recompute_canonical_json",
        "canonicalization": "utf8_ensure_ascii_false_sort_keys_true_compact_no_nan"
      }
    },
    "p8_export_contract_version": {
      "const": "1.1.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "policy_pin": {
      "$ref": "#/$defs/hashPin"
    },
    "source_split_pin": {
      "$ref": "#/$defs/hashPin"
    },
    "reservation_pin": {
      "$ref": "#/$defs/hashPin"
    },
    "owner_decision_record_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark",
        "staging"
      ],
      "properties": {
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_pin"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "file_pin": {
              "$ref": "#/$defs/hashPin"
            }
          }
        },
        "staging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_pin"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "file_pin": {
              "$ref": "#/$defs/hashPin"
            }
          }
        }
      }
    },
    "implementation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "file_pin"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "file_pin": {
            "$ref": "#/$defs/hashPin"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hashPin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "null"
            },
            "storage": {
              "const": "sha256_exact_file_bytes"
            },
            "consumption": {
              "const": "rehash_exact_file_bytes"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "content"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "null"
            },
            "storage": {
              "const": "sha256_canonical_json"
            },
            "consumption": {
              "const": "rehash_canonical_json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "self_field",
            "storage",
            "consumption"
          ],
          "properties": {
            "kind": {
              "const": "self"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "self_field": {
              "type": "string",
              "minLength": 1
            },
            "storage": {
              "const": "sha256_canonical_json_without_named_field"
            },
            "consumption": {
              "const": "remove_named_field_then_rehash"
            }
          }
        }
      ]
    }
  }
}
