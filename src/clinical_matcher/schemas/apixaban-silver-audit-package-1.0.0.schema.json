{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-silver-audit-package-1.0.0.schema.json",
  "title": "Restricted Apixaban silver citation audit package",
  "type": "object",
  "additionalProperties": false,
  "required": ["apixaban_silver_audit_package_version", "package_sha256", "generated_at", "code_commit", "generation_command", "source", "protocol", "population", "strata", "rows", "restrictions"],
  "properties": {
    "apixaban_silver_audit_package_version": {"const": "1.0.0"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generation_command": {"$ref": "#/$defs/text"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["silver_source", "candidate_artifact_sha256", "source_artifact_sha256", "benchmark_sha256", "staging_corpus_sha256", "split_manifest_sha256", "calibration_reservation_sha256", "input_policy_sha256", "question_catalog_sha256"],
      "properties": {
        "silver_source": {"enum": ["D", "E"]},
        "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"}, "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"}, "staging_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "split_manifest_sha256": {"$ref": "#/$defs/sha256"}, "calibration_reservation_sha256": {"$ref": "#/$defs/sha256"},
        "input_policy_sha256": {"$ref": "#/$defs/sha256"}, "question_catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocol": {"$ref": "#/$defs/protocol"},
    "population": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "stratum_count", "sample_count", "all_candidates_reviewed"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 1}, "stratum_count": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 1, "maximum": 100}, "all_candidates_reviewed": {"type": "boolean"}
      }
    },
    "strata": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stratum"}},
    "rows": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/row"}},
    "restrictions": {
      "type": "object", "additionalProperties": false,
      "required": ["contains_restricted_text", "owner_only", "online_upload_permitted", "independent_evidence_gold"],
      "properties": {"contains_restricted_text": {"const": true}, "owner_only": {"const": true}, "online_upload_permitted": {"const": false}, "independent_evidence_gold": {"const": false}}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"},
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["sampling_algorithm", "selection_salt", "allocation_version", "rubric_version", "review_budget", "reviewer_count", "reviewer_role"],
      "properties": {
        "sampling_algorithm": {"const": "sha256_stratified_silver_audit_sampling/1.0.0"},
        "selection_salt": {"const": "clinicalmatcher-p5-silver-audit-v1"}, "allocation_version": {"const": "1.0.0"}, "rubric_version": {"const": "1.0.0"},
        "review_budget": {"const": 100}, "reviewer_count": {"const": 1}, "reviewer_role": {"const": "data_owner"}
      }
    },
    "stratum": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "question_type", "fact_status", "candidate_count", "allocated_count"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^apixaban-q-[0-9a-f]{16}$"}, "question_type": {"enum": ["boolean", "numeric"]},
        "fact_status": {"enum": ["present", "absent"]}, "candidate_count": {"type": "integer", "minimum": 1}, "allocated_count": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_id", "source_span", "text"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/text"}, "source_id": {"$ref": "#/$defs/text"}, "text": {"$ref": "#/$defs/text"},
        "source_span": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["sampling_digest", "patient_id", "question_id", "question_type", "fact_status", "value", "unit", "source_question", "cited_evidence", "silver_source", "provenance_ids", "machine_checks"],
      "properties": {
        "sampling_digest": {"$ref": "#/$defs/sha256"}, "patient_id": {"type": "string", "pattern": "^patient-[0-9a-f]{24}$"}, "question_id": {"type": "string", "pattern": "^apixaban-q-[0-9a-f]{16}$"},
        "question_type": {"enum": ["boolean", "numeric"]}, "fact_status": {"enum": ["present", "absent"]}, "value": {"type": ["boolean", "number"]}, "unit": {"type": "null"},
        "source_question": {"$ref": "#/$defs/text"}, "cited_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "silver_source": {"enum": ["D", "E"]}, "provenance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "machine_checks": {"type": "object", "additionalProperties": false, "required": ["cross_patient_citation", "student_invisible_citation"], "properties": {"cross_patient_citation": {"const": false}, "student_invisible_citation": {"const": false}}}
      }
    }
  }
}
