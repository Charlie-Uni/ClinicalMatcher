{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/decomposition-llama-comparison-report-1.0.0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["report_version", "report_id", "report_sha256", "generated_at", "protocol_version", "split", "comparison_label", "contract_id", "contract_sha256", "prediction_id", "prediction_sha256", "silver_manifest_id", "silver_manifest_sha256", "model_roles", "owner_review_outcome", "claim_boundaries", "information_asymmetry", "no_item_resolution_subgroup", "overall_metrics", "failure_counts", "bootstrap", "items", "limitations"],
  "properties": {
    "report_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^decomposition-llama-comparison-dev-[0-9a-f]{16}$"},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "protocol_version": {"const": "decomposition-benchmark-protocol/1.3.0"},
    "split": {"const": "dev"},
    "comparison_label": {"const": "descriptive_agreement_with_codex_drafted_owner_accepted_silver"},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "prediction_id": {"type": "string", "minLength": 1},
    "prediction_sha256": {"$ref": "#/$defs/sha256"},
    "silver_manifest_id": {"type": "string", "minLength": 1},
    "silver_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "model_roles": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_draft_model_id", "evaluated_model_id", "relationship"],
      "properties": {"reference_draft_model_id": {"type": "string", "minLength": 1}, "evaluated_model_id": {"type": "string", "minLength": 1}, "relationship": {"type": "string", "minLength": 1}}
    },
    "owner_review_outcome": {"$ref": "#/$defs/reviewOutcome"},
    "claim_boundaries": {"$ref": "#/$defs/claimBoundaries"},
    "information_asymmetry": {"$ref": "#/$defs/subgroup"},
    "no_item_resolution_subgroup": {"$ref": "#/$defs/subgroup"},
    "overall_metrics": {"$ref": "#/$defs/metrics"},
    "failure_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "bootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["cluster_key", "samples", "seed", "confidence", "intervals"],
      "properties": {
        "cluster_key": {"const": "nct_id"}, "samples": {"const": 1000}, "seed": {"const": 17}, "confidence": {"const": 0.95},
        "intervals": {"type": "object", "additionalProperties": false, "required": ["atom_micro_f1", "operator_topology_exact_rate", "span_mean_iou"], "properties": {"atom_micro_f1": {"$ref": "#/$defs/interval"}, "operator_topology_exact_rate": {"$ref": "#/$defs/interval"}, "span_mean_iou": {"$ref": "#/$defs/interval"}}}
      }
    },
    "items": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/item"}},
    "limitations": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["criteria", "schema_valid_outputs", "schema_valid_rate", "semantic_valid_outputs", "semantic_valid_rate", "normalized_tree_exact_rate", "operator_topology_exact_rate", "reference_atoms", "predicted_atoms", "matched_atoms", "atom_micro_precision", "atom_micro_recall", "atom_micro_f1", "atom_macro_f1", "span_exact_rate", "span_mean_iou"],
      "properties": {
        "criteria": {"type": "integer", "minimum": 1}, "schema_valid_outputs": {"type": "integer", "minimum": 0}, "schema_valid_rate": {"$ref": "#/$defs/rate"}, "semantic_valid_outputs": {"type": "integer", "minimum": 0}, "semantic_valid_rate": {"$ref": "#/$defs/rate"},
        "normalized_tree_exact_rate": {"$ref": "#/$defs/rate"}, "operator_topology_exact_rate": {"$ref": "#/$defs/rate"},
        "reference_atoms": {"type": "integer", "minimum": 0}, "predicted_atoms": {"type": "integer", "minimum": 0}, "matched_atoms": {"type": "integer", "minimum": 0},
        "atom_micro_precision": {"$ref": "#/$defs/rate"}, "atom_micro_recall": {"$ref": "#/$defs/rate"}, "atom_micro_f1": {"$ref": "#/$defs/rate"}, "atom_macro_f1": {"$ref": "#/$defs/rate"},
        "span_exact_rate": {"$ref": "#/$defs/rate"}, "span_mean_iou": {"$ref": "#/$defs/rate"}
      }
    },
    "subgroup": {"type": "object", "additionalProperties": false, "required": ["item_count", "metrics"], "properties": {"item_count": {"type": "integer", "minimum": 1}, "evaluated_model_received_item_resolutions": {"const": false}, "metrics": {"$ref": "#/$defs/metrics"}}},
    "reviewOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "accepted_unchanged", "accepted_with_edits", "review_notes", "evidence_strength_limitation"],
      "properties": {"total": {"const": 40}, "accepted_unchanged": {"const": 40}, "accepted_with_edits": {"const": 0}, "review_notes": {"const": 0}, "evidence_strength_limitation": {"type": "string", "minLength": 1}}
    },
    "claimBoundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["independent_human_gold", "clinical_ground_truth", "inter_annotator_agreement", "decomposition_accuracy", "grpo_semantic_oracle", "permitted_claim"],
      "properties": {"independent_human_gold": {"const": false}, "clinical_ground_truth": {"const": false}, "inter_annotator_agreement": {"const": false}, "decomposition_accuracy": {"const": false}, "grpo_semantic_oracle": {"const": false}, "permitted_claim": {"type": "string", "minLength": 1}}
    },
    "interval": {"type": "object", "additionalProperties": false, "required": ["estimate", "lower", "upper", "confidence", "samples", "cluster_count"], "properties": {"estimate": {"$ref": "#/$defs/rate"}, "lower": {"$ref": "#/$defs/rate"}, "upper": {"$ref": "#/$defs/rate"}, "confidence": {"const": 0.95}, "samples": {"const": 1000}, "cluster_count": {"type": "integer", "minimum": 1}}},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["nct_id", "criterion_id", "information_asymmetry", "output_status", "failure_reason", "normalized_tree_exact", "operator_topology_exact", "reference_atoms", "predicted_atoms", "matched_atoms", "atom_f1", "span_exact", "span_iou_sum", "equivalence_review_queued", "disagreement_types"],
      "properties": {
        "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"}, "criterion_id": {"type": "string", "minLength": 1}, "information_asymmetry": {"type": "boolean"},
        "output_status": {"enum": ["valid", "schema_invalid", "semantic_invalid", "runtime_error"]}, "failure_reason": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "normalized_tree_exact": {"type": "boolean"}, "operator_topology_exact": {"type": "boolean"},
        "reference_atoms": {"type": "integer", "minimum": 0}, "predicted_atoms": {"type": "integer", "minimum": 0}, "matched_atoms": {"type": "integer", "minimum": 0}, "atom_f1": {"$ref": "#/$defs/rate"}, "span_exact": {"type": "integer", "minimum": 0}, "span_iou_sum": {"type": "number", "minimum": 0}, "equivalence_review_queued": {"type": "boolean"}, "disagreement_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
