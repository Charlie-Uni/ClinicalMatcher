{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinicalmatcher.local/schemas/p7-representative-case-package-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_version", "package_sha256", "algorithm", "salt", "contract_sha256", "view_id", "split_name", "cases", "review_status", "owner_only"],
  "properties": {
    "package_version": {"const": "1.0.0"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "algorithm": {"const": "lowest_sha256_per_observed_attribution_category/1.0.0"},
    "salt": {"const": "clinicalmatcher-p7-p4-5-case-review-v1"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "view_id": {"const": "llama31_long_context_1_0_0.p4_3"},
    "split_name": {"enum": ["validation", "test"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "sampling_digest", "patient_id", "question_id", "source_question", "gold", "prediction", "patient_evidence"],
        "properties": {
          "category": {"enum": ["unsupported_answering", "unit_contract_error", "abstention_on_gold_known", "numeric_value_error", "fact_status_error_with_patient_local_citation", "other_typed_error"]},
          "sampling_digest": {"$ref": "#/$defs/sha256"},
          "patient_id": {"type": "string", "pattern": "^patient-[0-9a-f]{24}$"},
          "question_id": {"type": "string", "pattern": "^apixaban-q-[0-9a-f]{16}$"},
          "source_question": {"type": "string", "minLength": 1},
          "gold": {"$ref": "#/$defs/fact"},
          "prediction": {"$ref": "#/$defs/prediction"},
          "patient_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "text"],
              "properties": {
                "evidence_id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "review_status": {"const": "pending_owner_review_after_immutable_batch"},
    "owner_only": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_status", "value", "unit"],
      "properties": {
        "fact_status": {"enum": ["present", "absent", "unknown"]},
        "value": {"type": ["boolean", "number", "null"]},
        "unit": {"type": ["string", "null"]}
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_status", "value", "unit", "evidence_ids", "abstained", "abstention_reason"],
      "properties": {
        "fact_status": {"enum": ["present", "absent", "unknown"]},
        "value": {"type": ["boolean", "number", "null"]},
        "unit": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "abstained": {"type": "boolean"},
        "abstention_reason": {"type": ["string", "null"]}
      }
    }
  }
}
