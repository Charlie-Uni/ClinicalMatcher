{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-benchmark-1.0.0.schema.json",
  "title": "Restricted Apixaban note-grounded fact benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apixaban_benchmark_version",
    "source",
    "contract",
    "patient_ids",
    "assessments"
  ],
  "properties": {
    "apixaban_benchmark_version": {"const": "1.0.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "source_csv_sha256",
        "staging_corpus_sha256",
        "import_manifest_sha256"
      ],
      "properties": {
        "dataset_id": {"const": "MIMIC-IV-Ext-Apixaban-Trial-Criteria-Questions"},
        "dataset_version": {"const": "1.0.0"},
        "source_csv_sha256": {"$ref": "#/$defs/sha256"},
        "staging_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "import_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_catalog_version",
        "question_catalog_sha256",
        "fact_assessment_version",
        "prediction_target",
        "patient_text_storage",
        "gold_evidence_status"
      ],
      "properties": {
        "question_catalog_version": {"const": "1.0.0"},
        "question_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "fact_assessment_version": {"const": "1.0.0"},
        "prediction_target": {"const": "note_grounded_fact_assessment"},
        "patient_text_storage": {"const": "external_restricted_staging_corpus"},
        "gold_evidence_status": {"const": "not_available_in_source"}
      }
    },
    "patient_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/patientId"}
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assessment"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "patientId": {"type": "string", "pattern": "^patient-[0-9a-f]{24}$"},
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_assessment_version",
        "question_catalog_version",
        "assessment_id",
        "patient_id",
        "question_id",
        "question_type",
        "assessment_source",
        "fact_status",
        "value",
        "unit",
        "evidence_status",
        "evidence_ids",
        "abstained",
        "abstention_reason"
      ],
      "properties": {
        "fact_assessment_version": {"const": "1.0.0"},
        "question_catalog_version": {"const": "1.0.0"},
        "assessment_id": {
          "type": "string",
          "pattern": "^apixaban-a-[0-9a-f]{24}$"
        },
        "patient_id": {"$ref": "#/$defs/patientId"},
        "question_id": {
          "type": "string",
          "pattern": "^apixaban-q-[0-9a-f]{16}$"
        },
        "question_type": {"enum": ["boolean", "numeric"]},
        "assessment_source": {"const": "released_source_label"},
        "fact_status": {"enum": ["present", "absent", "unknown"]},
        "value": {"type": ["boolean", "number", "null"]},
        "unit": {"type": "null"},
        "evidence_status": {"const": "not_available_in_source"},
        "evidence_ids": {"type": "array", "maxItems": 0},
        "abstained": {"type": "boolean"},
        "abstention_reason": {
          "type": ["string", "null"],
          "enum": [null, "source_not_specified", "source_anomaly"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"fact_status": {"const": "unknown"}}},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "abstained": {"const": true},
              "abstention_reason": {"type": "string"}
            }
          },
          "else": {
            "properties": {
              "abstained": {"const": false},
              "abstention_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"question_type": {"const": "boolean"}}},
          "then": {
            "oneOf": [
              {
                "properties": {
                  "fact_status": {"const": "present"},
                  "value": {"const": true}
                }
              },
              {
                "properties": {
                  "fact_status": {"const": "absent"},
                  "value": {"const": false}
                }
              },
              {
                "properties": {
                  "fact_status": {"const": "unknown"},
                  "value": {"type": "null"}
                }
              }
            ]
          },
          "else": {
            "oneOf": [
              {
                "properties": {
                  "fact_status": {"const": "present"},
                  "value": {"type": "number"}
                }
              },
              {
                "properties": {
                  "fact_status": {"const": "unknown"},
                  "value": {"type": "null"}
                }
              }
            ]
          }
        }
      ]
    }
  }
}
