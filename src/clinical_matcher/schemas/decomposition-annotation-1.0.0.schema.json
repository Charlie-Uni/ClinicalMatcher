{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/decomposition-annotation-1.0.0.schema.json",
  "title": "Independent public criteria-decomposition annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decomposition_annotation_version", "protocol_version", "annotation_id",
    "annotation_sha256", "selection_manifest_id", "selection_manifest_sha256",
    "concept_catalog_id", "concept_catalog_sha256", "annotation_guide_version",
    "annotation_guide_sha256", "split", "annotator_id", "annotation_mode",
    "annotation_status", "independence_attestation", "items"
  ],
  "properties": {
    "decomposition_annotation_version": {"const": "1.0.0"},
    "protocol_version": {"const": "decomposition-benchmark-protocol/1.0.0"},
    "annotation_id": {"type": "string", "pattern": "^decomposition-annotation-(dev|test)-[0-9a-f]{16}$"},
    "annotation_sha256": {"$ref": "#/$defs/sha256"},
    "selection_manifest_id": {"type": "string", "pattern": "^decomposition-selection-[0-9a-f]{16}$"},
    "selection_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "concept_catalog_id": {"type": "string", "pattern": "^decomposition-catalog-(dev|test)-[0-9a-f]{16}$"},
    "concept_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "annotation_guide_version": {"$ref": "#/$defs/nonEmptyString"},
    "annotation_guide_sha256": {"$ref": "#/$defs/sha256"},
    "split": {"enum": ["dev", "test"]},
    "annotator_id": {"$ref": "#/$defs/nonEmptyString"},
    "annotation_mode": {"enum": ["dual_independent_with_adjudication", "single_annotator"]},
    "annotation_status": {"enum": ["draft", "completed"]},
    "independence_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["other_annotations_not_viewed", "model_outputs_not_viewed"],
      "properties": {
        "other_annotations_not_viewed": {"type": "boolean"},
        "model_outputs_not_viewed": {"type": "boolean"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "typedValue": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["value_type", "value"],
          "properties": {
            "value_type": {"const": "number"},
            "value": {"type": "number"},
            "unit": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["value_type", "value"],
          "properties": {"value_type": {"const": "boolean"}, "value": {"type": "boolean"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["value_type", "value"],
          "properties": {"value_type": {"const": "string"}, "value": {"type": "string"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["value_type", "value"],
          "properties": {"value_type": {"const": "date"}, "value": {"type": "string", "format": "date"}}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_span", "method"],
      "properties": {
        "source_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_span": {"$ref": "#/$defs/sourceSpan"},
        "method": {"const": "human"}
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "direction", "relative_to"],
      "properties": {
        "days": {"type": "integer", "minimum": 1},
        "direction": {"enum": ["past", "future"]},
        "relative_to": {"const": "index_date"}
      }
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "field", "operator", "expected", "fact_selection", "provenance"],
      "properties": {
        "condition_id": {"$ref": "#/$defs/nonEmptyString"},
        "field": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "operator": {"enum": ["==", "!=", ">", ">=", "<", "<="]},
        "expected": {"$ref": "#/$defs/typedValue"},
        "fact_selection": {"enum": ["any", "all", "latest"]},
        "provenance": {"$ref": "#/$defs/provenance"},
        "time_window": {"$ref": "#/$defs/timeWindow"}
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["expression_type", "atom"],
          "properties": {"expression_type": {"const": "atom"}, "atom": {"$ref": "#/$defs/atom"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["expression_type", "children"],
          "properties": {
            "expression_type": {"enum": ["all", "any"]},
            "children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["expression_type", "children"],
          "properties": {
            "expression_type": {"const": "not"},
            "children": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/expression"}}
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nct_id", "criterion_id", "criterion_type", "source_id",
        "source_record_version", "protocol_sha256", "eligibility_sha256",
        "source_span", "source_text", "expression"
      ],
      "properties": {
        "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
        "criterion_id": {"$ref": "#/$defs/nonEmptyString"},
        "criterion_type": {"enum": ["inclusion", "exclusion"]},
        "source_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_record_version": {"$ref": "#/$defs/nonEmptyString"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "eligibility_sha256": {"$ref": "#/$defs/sha256"},
        "source_span": {"$ref": "#/$defs/sourceSpan"},
        "source_text": {"$ref": "#/$defs/nonEmptyString"},
        "expression": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/expression"}]}
      }
    }
  }
}
