{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-sft-export-manifest-1.1.0.schema.json",
  "title": "Restricted Apixaban SFT export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apixaban_sft_export_manifest_version", "manifest_sha256", "generated_at", "code_commit", "generation_command", "source", "input_contract", "row_policy", "counts", "per_question", "outputs", "sequence_validation", "restrictions"],
  "properties": {
    "apixaban_sft_export_manifest_version": {"const": "1.1.0"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generation_command": {"$ref": "#/$defs/nonEmptyString"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_sha256", "staging_corpus_sha256", "split_manifest_sha256", "calibration_reservation_sha256", "question_catalog_sha256"],
      "properties": {
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "staging_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "calibration_reservation_sha256": {"$ref": "#/$defs/sha256"},
        "question_catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_policy_id", "input_policy_sha256", "prompt_version", "system_instruction_sha256", "length_report_sha256", "model_id", "model_revision", "tokenizer_sha256", "tokenizer_config_sha256", "chat_template_sha256", "output_reserve_tokens", "max_seq_len", "overflow_policy"],
      "properties": {
        "input_policy_id": {"const": "all-complete-evidence-v1"},
        "input_policy_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_version": {"const": "apixaban-single-fact-sft-1.0.0"},
        "system_instruction_sha256": {"$ref": "#/$defs/sha256"},
        "length_report_sha256": {"$ref": "#/$defs/sha256"},
        "model_id": {"const": "meta-llama/Llama-3.1-8B-Instruct"},
        "model_revision": {"const": "0e9e39f249a16976918f6564b8830bc894c89659"},
        "tokenizer_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_config_sha256": {"$ref": "#/$defs/sha256"},
        "chat_template_sha256": {"$ref": "#/$defs/sha256"},
        "output_reserve_tokens": {"const": 512},
        "max_seq_len": {"enum": [2048, 4096, 8192, 16384]},
        "overflow_policy": {"const": "measured_failure_abstention_no_truncation"}
      }
    },
    "row_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "training_partition", "calibration_excluded", "validation_excluded", "test_excluded", "silver_priority", "uncovered_known_action"],
      "properties": {
        "version": {"const": "1.0.0"},
        "training_partition": {"const": "train_fit"},
        "calibration_excluded": {"const": true},
        "validation_excluded": {"const": true},
        "test_excluded": {"const": true},
        "silver_priority": {"const": ["D", "E"]},
        "uncovered_known_action": {"const": "exclude"}
      }
    },
    "counts": {"$ref": "#/$defs/counts"},
    "per_question": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/counts"},
          {
            "type": "object",
            "required": ["question_id"],
            "properties": {"question_id": {"$ref": "#/$defs/questionId"}}
          }
        ]
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_jsonl_sha256", "mlx_jsonl_sha256", "medicalgpt_jsonl_sha256"],
      "properties": {
        "canonical_jsonl_sha256": {"$ref": "#/$defs/sha256"},
        "mlx_jsonl_sha256": {"$ref": "#/$defs/sha256"},
        "medicalgpt_jsonl_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sequence_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "max_prompt_tokens", "max_actual_target_tokens", "max_full_tokens", "every_target_within_reserve", "every_reserved_sequence_within_context"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 1},
        "max_prompt_tokens": {"type": "integer", "minimum": 1},
        "max_actual_target_tokens": {"type": "integer", "minimum": 0},
        "max_full_tokens": {"type": "integer", "minimum": 1},
        "every_target_within_reserve": {"const": true},
        "every_reserved_sequence_within_context": {"const": true}
      }
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_restricted_text", "owner_only", "online_upload_permitted", "silver_is_evidence_gold"],
      "properties": {
        "contains_restricted_text": {"const": true},
        "owner_only": {"const": true},
        "online_upload_permitted": {"const": false},
        "silver_is_evidence_gold": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "questionId": {"type": "string", "pattern": "^apixaban-q-[0-9a-f]{16}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_pair_count", "included_row_count", "excluded_known_without_silver_count", "accepted_d_count", "accepted_e_count", "unknown_empty_evidence_count", "default_absent_exception_count"],
      "properties": {
        "question_id": {"$ref": "#/$defs/questionId"},
        "train_fit_patient_count": {"type": "integer", "minimum": 1},
        "eligible_pair_count": {"type": "integer", "minimum": 1},
        "included_row_count": {"type": "integer", "minimum": 0},
        "excluded_known_without_silver_count": {"type": "integer", "minimum": 0},
        "accepted_d_count": {"type": "integer", "minimum": 0},
        "accepted_e_count": {"type": "integer", "minimum": 0},
        "unknown_empty_evidence_count": {"type": "integer", "minimum": 0},
        "default_absent_exception_count": {"type": "integer", "minimum": 0}
      },
      "anyOf": [
        {"required": ["train_fit_patient_count"]},
        {"required": ["question_id"]}
      ]
    }
  }
}
