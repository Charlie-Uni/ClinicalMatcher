{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charlie-Uni/ClinicalMatcher/schemas/apixaban-numeric-occurrence-report-1.0.0.schema.json",
  "title": "Restricted Apixaban numeric answer occurrence diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version", "report_sha256", "generated_at", "code_commit",
    "provenance", "configuration", "population", "retrievers",
    "interpretation", "disclosure_note"
  ],
  "properties": {
    "report_version": {"const": "1.0.0"},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_csv_sha256", "benchmark_sha256", "staging_corpus_sha256",
        "split_manifest_sha256", "split_name", "question_catalog_sha256",
        "contract_sha256", "component_run_sha256"
      ],
      "properties": {
        "source_csv_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "staging_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "split_name": {"const": "validation"},
        "question_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "component_run_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["bm25", "medcpt_dense", "rrf60"],
          "properties": {
            "bm25": {"$ref": "#/$defs/sha256"},
            "medcpt_dense": {"$ref": "#/$defs/sha256"},
            "rrf60": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": [
        "contract_id", "matching_method", "token_pattern", "comparison",
        "cutoffs", "selected_match_scope", "test_labels_used"
      ],
      "properties": {
        "contract_id": {"const": "apixaban-numeric-answer-occurrence-v1"},
        "matching_method": {"const": "independent_decimal_token_exact_value"},
        "token_pattern": {"type": "string", "minLength": 1},
        "comparison": {"const": "exact_decimal_equality"},
        "cutoffs": {"const": [1, 3]},
        "selected_match_scope": {"const": "within_any_individual_selected_chunk"},
        "test_labels_used": {"const": false}
      }
    },
    "population": {
      "type": "object", "additionalProperties": false,
      "required": [
        "split_assessment_count", "boolean_excluded_count",
        "numeric_assessment_count", "numeric_unknown_excluded_count",
        "protocol_value_excluded_count",
        "full_context_absent_excluded_count", "evaluable_count",
        "evaluable_fraction_of_numeric", "reconciliation_passed"
      ],
      "properties": {
        "split_assessment_count": {"type": "integer", "minimum": 1},
        "boolean_excluded_count": {"type": "integer", "minimum": 0},
        "numeric_assessment_count": {"type": "integer", "minimum": 1},
        "numeric_unknown_excluded_count": {"type": "integer", "minimum": 0},
        "protocol_value_excluded_count": {"type": "integer", "minimum": 0},
        "full_context_absent_excluded_count": {"type": "integer", "minimum": 0},
        "evaluable_count": {"type": "integer", "minimum": 1},
        "evaluable_fraction_of_numeric": {"type": "number", "minimum": 0, "maximum": 1},
        "reconciliation_passed": {"const": true}
      }
    },
    "retrievers": {
      "type": "object", "additionalProperties": false,
      "required": ["bm25", "medcpt_dense", "rrf60"],
      "properties": {
        "bm25": {"$ref": "#/$defs/retriever"},
        "medcpt_dense": {"$ref": "#/$defs/retriever"},
        "rrf60": {"$ref": "#/$defs/retriever"}
      }
    },
    "interpretation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "signal_tier", "independent_evidence_gold",
        "evidence_relevance_metric", "allowed_claim", "forbidden_claim",
        "limitations"
      ],
      "properties": {
        "signal_tier": {"const": "weak_diagnostic"},
        "independent_evidence_gold": {"const": false},
        "evidence_relevance_metric": {"const": false},
        "allowed_claim": {"type": "string", "minLength": 1},
        "forbidden_claim": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "disclosure_note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retriever": {
      "type": "object", "additionalProperties": false,
      "required": [
        "evaluable_count", "occurrence_at_1_count", "occurrence_at_1_rate",
        "occurrence_at_3_count", "occurrence_at_3_rate"
      ],
      "properties": {
        "evaluable_count": {"type": "integer", "minimum": 1},
        "occurrence_at_1_count": {"type": "integer", "minimum": 0},
        "occurrence_at_1_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "occurrence_at_3_count": {"type": "integer", "minimum": 0},
        "occurrence_at_3_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
